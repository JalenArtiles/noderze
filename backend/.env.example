# Copy to backend/.env and fill in. Never commit the real file.

# Required: a long random string. The frontend sends it on every request.
AGENT_TOKEN=change-me-to-a-long-random-string

# Database. SQLite works with zero setup; use Postgres via docker compose for daily use.
# DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# Optional but recommended: enables extraction, rewriting, cover letters, mock interviews,
# and (with search_provider=anthropic or auto) web search through Claude's web search tool.
# Web search must be enabled for your organization in the Claude Console.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001

# Search provider: auto | anthropic | tavily | brave | serper | none
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Polite fetching: identify yourself honestly.
HTTP_USER_AGENT=SECareerAgent/0.1 (personal job search assistant)
FETCH_MIN_INTERVAL_S=2.0

EXPECTED_GRADUATION=2027-05-15
TIMEZONE=America/Phoenix
ENABLE_SCHEDULER=true

# Even when true, applications with unverified claims are never auto-submitted.
TRUSTED_AUTO_SUBMIT=false
